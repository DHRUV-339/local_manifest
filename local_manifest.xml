<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <!-- Remotes -->
    <remote name="lineage"
            fetch="https://github.com/LineageOS"
            revision="refs/heads/lineage-22.2" />

    <remote name="muppets"
            fetch="https://github.com/TheMuppets"
            revision="refs/heads/lineage-22.2" />

    <!-- Device Trees -->
    <project name="android_device_xiaomi_vayu" 
             path="device/xiaomi/vayu" 
             remote="lineage" />

    <project name="android_device_xiaomi_sm8150-common" 
             path="device/xiaomi/sm8150-common" 
             remote="lineage" />

    <!-- Kernel Tree -->
    <project name="android_kernel_xiaomi_sm8150" 
             path="kernel/xiaomi/sm8150" 
             remote="lineage" />

    <!-- Vendor Blobs -->
    <project name="proprietary_vendor_xiaomi_vayu" 
             path="vendor/xiaomi/vayu" 
             remote="muppets" />

    <project name="proprietary_vendor_xiaomi_sm8150-common" 
             path="vendor/xiaomi/sm8150-common" 
             remote="muppets" />

    <!-- Xiaomi Hardware Support -->
    <project name="android_hardware_xiaomi" 
             path="hardware/xiaomi" 
             remote="lineage" />
</manifest>